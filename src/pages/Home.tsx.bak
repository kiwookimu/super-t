        {/* Quick Actions */}
        <div className="flex space-x-3 overflow-x-auto no-scrollbar py-1 -mx-1 px-1">
            <QuickAction icon={<Ticket size={18} />} label="쿠폰함" onClick={() => onNavigate('/benefits/coupons')} />
